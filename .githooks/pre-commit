#!/usr/bin/env bash
#
# pre-commit: the FAST tier — the part of the gate that must be seconds, not minutes.
#
# from AI-DEV-STARTER (plunk-in kit) — if you edit this file, say why in INCIDENTS.md.
# Install as .githooks/pre-commit and arm it once per clone:
#
#     git config core.hooksPath .githooks
#
# Nothing leaves the machine to make this work: no GitHub, no service, no account.
#
# FSMgine-specific order (measured 2026-09-30: configure 0.05 s, build 0.11 s,
# tests 0.02 s, clang-tidy 4.3 s/TU, clang-format 9.4 s for the whole tree):
#   format  first  — it defines the text the later stages judge
#   build          — produces the compile database clang-tidy needs
#   lint           — scoped to the TUs this commit touches, so a typical commit
#                    is 3-10 s rather than the ~25 s a full lint costs
#   tests          — last: the most decisive stage, after the cheap ones passed
#
# Deliberate bypass when you need one:  git commit --no-verify
#
set -uo pipefail

root=$(git rev-parse --show-toplevel) || exit 1

if [ -x "$root/tools/ci.sh" ]; then
    exec "$root/tools/ci.sh" --changed format build lint tests
fi

# No gate found is a failure, not a warning: a silently unarmed gate is worse than
# no gate, because it looks armed.
printf 'pre-commit: no gate found. Expected %s/tools/ci.sh\n' "$root" >&2
exit 1
