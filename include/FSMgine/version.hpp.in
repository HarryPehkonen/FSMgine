#pragma once
// GENERATED at configure time from CMakeLists.txt's `project(FSMgine VERSION ...)`.
//
// Do not edit this header, and do not write a version anywhere else: edit the project() line
// — or run `tools/release.sh prepare --apply`, which edits it for you — and rebuild.
//
// Not included by <FSMgine/FSMgine.hpp>: include it explicitly, only where the version is
// actually wanted, so the umbrella header stays free of build-tree dependencies.
//
// The numbers are `constexpr`, not macros: a generated header should not need suppressions,
// and version gating reads better as `if constexpr (fsmgine::version_major >= 2)` than as a
// preprocessor conditional.
#include <string_view>

namespace fsmgine {

/// @brief Major version number (X in X.Y.Z)
inline constexpr int version_major = @PROJECT_VERSION_MAJOR@;

/// @brief Minor version number (Y in X.Y.Z)
inline constexpr int version_minor = @PROJECT_VERSION_MINOR@;

/// @brief Patch version number (Z in X.Y.Z)
inline constexpr int version_patch = @PROJECT_VERSION_PATCH@;

/// @brief The library version as a string, e.g. "1.4.0"
/// @return The version configured in CMakeLists.txt
[[nodiscard]] inline constexpr std::string_view version() noexcept { return "@PROJECT_VERSION@"; }

} // namespace fsmgine
